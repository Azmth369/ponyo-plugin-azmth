# Required: URL of the existing Ponyo API service, without a trailing slash
PONYO_API_BASE_URL=https://ponyo-v845.onrender.com

# Required: same API key configured as PONYO_API_KEY on the existing Ponyo Render service.
# Set this only in the new plugin service's Render environment; never commit the real value.
PONYO_API_KEY=

# Set by Render automatically; defaults to 8787 for local development.
PORT=8787
