# Existing Ponyo API base URL, without a trailing slash
PONYO_API_BASE_URL=https://ponyo-azmth.onrender.com

# Existing backend API key. Set only in the Render service environment.
PONYO_API_KEY=

# Separate client-to-MCP bearer secret (minimum 32 characters).
# Never commit a real value or reuse PONYO_API_KEY.
MCP_BEARER_TOKEN=

# Set by Render automatically; defaults to 8787 for local development.
PORT=8787
